# ──────────────────────────────────────────────────────────────
# Шаблон переменных окружения. Реальные значения НЕ коммитить.
# Копируйте нужные блоки в backend/.env (сервер) и frontend/.env.local (клиент).
# ──────────────────────────────────────────────────────────────

# ─── API / Prisma (backend/.env) ──────────────────────────────
# Neon PostgreSQL — pooled connection (для runtime-запросов)
DATABASE_URL="postgresql://USER:PASS@HOST-pooler REGION/neondb?sslmode=require&pgbouncer=true&connection_limit=5&pool_timeout=20&connect_timeout=15"
# Neon — прямое соединение (для миграций, в обход PgBouncer)
DIRECT_URL="postgresql://USER:PASS@HOST REGION/neondb?sslmode=require&connect_timeout=15"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Firebase Admin — projectId достаточно для verifyIdToken;
# service account (client_email + private_key) нужен только для управления пользователями.
FIREBASE_PROJECT_ID="barbershop-b2e1c"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Redis: soft-lock слотов, потолки ИИ, очередь BullMQ.
# Пусто = dev-режим: генерации выполняются в процессе API, защита от двойной брони — в БД.
REDIS_URL=""
SALON_TZ="Asia/Bishkek"
SALON_ADDRESS="г. Бишкек, ул. Московская, 123"
# Email-адреса, получающие роль owner (админка) при входе/регистрации (через запятую)
ADMIN_EMAILS=""
# Секрет подписи JWT-сессий сайта (длинная случайная строка, 32+ символов)
JWT_SECRET=""

# Приватное хранилище фото (локальная папка) и подпись ссылок (TTL 10 мин)
STORAGE_DIR="./storage"
STORAGE_SIGNING_SECRET="change-me-long-random-string"
# Публичный адрес API — для подписанных ссылок на фото/результаты
API_PUBLIC_URL="http://localhost:3001"

# ИИ: auto (gemini, если есть ключ, иначе демо) | gemini | mock | hf
AI_PROVIDER="gemini"
# Бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Актуальная модель генерации и редактирования изображений (1K около $0.067)
GEMINI_MODEL="gemini-3.1-flash-image"
GEMINI_COST_USD="0.07"
AI_MODEL_VERSION="gemini-3.1-flash-image"
HF_API_TOKEN=""
HF_MODEL="timbrooks/instruct-pix2pix"
# IP салона — без лимита генераций с IP (демонстрация сотрудниками)
AI_IP_WHITELIST=""

# Cloudflare Turnstile (капча перед загрузкой фото, ИИ-генерацией и формой).
# Пусто = проверка отключена. Пара ключей: secret → API, site key → web.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Telegram-уведомления владельцу (новые записи, отмены, алерты бюджета ИИ)
TELEGRAM_BOT_TOKEN=""
# Необязательно: chat id владельца (напишите боту /id). Админы также подключают
# Telegram в личном кабинете кнопкой «Подключить».
TELEGRAM_OWNER_CHAT_ID=""
# false — не запускать long polling (например, во втором экземпляре API)
TELEGRAM_POLLING="true"
# Адрес сайта — для кнопок в боте
PUBLIC_SITE_URL="http://localhost:3000"

# Письма о заказах (необязательно; без SMTP письма только логируются)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="BARS Barber Club <no-reply@bars.kg>"

# ─── Web / Next.js (frontend/.env.local) ───────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
