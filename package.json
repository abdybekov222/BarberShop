{
  "name": "barbershop",
  "private": true,
  "version": "0.1.0",
  "description": "Премиальный сайт барбершопа (Кыргызстан) с ИИ-примеркой причёсок",
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "dev:web": "pnpm --filter @barbershop/web dev",
    "dev:api": "pnpm --filter @barbershop/api dev",
    "build": "pnpm --filter @barbershop/shared build && pnpm -r --filter @barbershop/web --filter @barbershop/api run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @barbershop/api exec prisma generate",
    "db:migrate": "pnpm --filter @barbershop/api exec prisma migrate dev",
    "db:deploy": "pnpm --filter @barbershop/api exec prisma migrate deploy",
    "db:seed": "pnpm --filter @barbershop/api exec tsx prisma/seed.ts",
    "db:studio": "pnpm --filter @barbershop/api exec prisma studio",
    "postinstall": "pnpm --filter @barbershop/shared build || corepack pnpm --filter @barbershop/shared build",
    "dev:frontend": "pnpm --filter @barbershop/web dev",
    "dev:backend": "pnpm --filter @barbershop/api dev"
  },
  "devDependencies": {
    "eslint": "9.16.0",
    "typescript-eslint": "8.18.0",
    "typescript": "5.6.3"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  }
}
