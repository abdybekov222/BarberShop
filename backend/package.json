{
  "name": "@barbershop/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate --schema=prisma/schema.prisma && nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@barbershop/shared": "workspace:*",
    "@huggingface/inference": "^4.13.32",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.1.18",
    "@nestjs/core": "11.1.18",
    "@nestjs/platform-express": "11.1.18",
    "@prisma/client": "5.22.0",
    "bullmq": "5.28.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cloudinary": "2.11.0",
    "date-fns": "3.6.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "16.4.7",
    "firebase-admin": "12.6.0",
    "ioredis": "5.4.1",
    "multer": "2.5.0",
    "nodemailer": "10.3.1",
    "prisma": "5.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "sharp": "0.35.5",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.9.0",
    "@types/nodemailer": "8.0.2",
    "@types/uuid": "10.0.0",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  }
}
